        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-164" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;" value="" vertex="1">
          <mxGeometry height="29.5" width="219" x="1150" y="1151" as="geometry" />
        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-165" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Linux v2.2&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;Kernel version 2.2 is released.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The credibility of the kernel reaches new heights as the &lt;b&gt;TCP/IP stack&lt;/b&gt; matures, enough to handle server workloads. &lt;b&gt;Multiprocessor handling&lt;/b&gt; is improved. Device and bus support is expanded. Support for &lt;b&gt;USB&lt;/b&gt; hardware speeds up general adoption.&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="200.3" x="1159.7" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-166" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fontColor=#000000;fontSize=10;" value="&lt;h3&gt;&lt;span&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;1999&lt;/font&gt;&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="8" width="28.83" x="1337.7" y="1153.5" as="geometry" />
        </mxCell>

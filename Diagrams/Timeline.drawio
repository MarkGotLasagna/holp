        </mxCell>
        <mxCell id="y3qk_V9-Pjwn1zJk7Lkb-2" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Open Office suite&lt;/h3&gt;&lt;div&gt;Sun Microsystems releases an open-source version of StarOffice, &lt;b&gt;OpenOffice&lt;/b&gt;, a free alternative to Microsoft Office.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;An open-source fork of the project, &lt;b&gt;LibreOffice&lt;/b&gt;, will be later released and actively developed on. &lt;a href=&quot;https://en.wikipedia.org/wiki/LibreOffice&quot;&gt;[21]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1357.79" y="438.16" width="162.21" height="181.84" as="geometry" />

        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-71" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Design of the UNIX Operating System&lt;/h3&gt;&lt;div&gt;Maurice J. Bach, of AT&amp;amp;T Bell Labs, publishes the definitive description of the UNIX operating systems, covering System V Release 2 kernel and some features from Release 3 and BSD.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="193.83" x="678.4000000000001" y="639.5" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-81" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#F3FFDF;shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="261.5" width="210" x="670.23" y="808" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-96" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;MINIX&lt;/h3&gt;&lt;div&gt;A Unix-like operating system based on a microkernel architecture, &lt;b&gt;MINIX&lt;/b&gt;, is released. It is written by American-Dutch computer scientist &lt;b&gt;Andrew S. Tanenbaum&lt;/b&gt;. Designed as a clone of the Unix operating system; MINIX is targeted for &lt;i&gt;use in classrooms by computer science students at universities&lt;/i&gt;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Its name comes from &lt;i&gt;mini-Unix&lt;/i&gt;. It is proprietary source-available, but will be relicensed under the BSD 3-Clause to later become &lt;i&gt;free and open-source&lt;/i&gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="251.5" width="193.68" x="678.5500000000001" y="808" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#FDFFE1;shadow=1;labelBorderColor=none;textShadow=0;glass=0;opacity=95;" value="" vertex="1">
          <mxGeometry height="270" width="210" x="670" y="190" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-65" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;fontFamily=Helvetica;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Intel 386 &lt;br&gt;processor&lt;/h3&gt;&lt;div&gt;The&amp;nbsp;&lt;b&gt;80386&lt;/b&gt;&amp;nbsp;(&lt;b&gt;i386&lt;/b&gt;) is released, the first &lt;b&gt;x86&lt;/b&gt; microprocessor with a &lt;b&gt;32-bit instruction set&lt;/b&gt; in the line. It is jointly developed by AMD, IBM and Intel.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;It is the first CPU to implement the &lt;b&gt;IA-32&lt;/b&gt; microarchitecture. It will be the brains of many workstations and high-end personal computers. Thanks to its &lt;i&gt;memory management unit&lt;/i&gt; (MMU) with &lt;i&gt;paging&lt;/i&gt;, it is much easier to implement operating systems using virtual memory.&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="194.33" x="680" y="190" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-790" edge="1" parent="1" style="endArrow=oval;html=1;rounded=0;startArrow=oval;startFill=1;endFill=1;shadow=1;flowAnimation=0;entryX=0.401;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" target="HhSyCPqw7SMtaCZ9Isdi-165" value="">

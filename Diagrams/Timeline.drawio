        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-182" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" value="&lt;h3&gt;&lt;span&gt;2008&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="1570" y="120" as="geometry" />
        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-185" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFDFDF,#392E29);shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="180" width="260" x="1390" y="2690" as="geometry" />
        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-186" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Wayland&amp;nbsp;protocol&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Wayland&lt;/b&gt;, a communication protocol that specifies communication between a &lt;i&gt;display server&lt;/i&gt; and its &lt;i&gt;clients&lt;/i&gt;, is released. A display server using Wayland protocol is called a &lt;b&gt;Wayland compositor&lt;/b&gt;. It is a free and open-source community-driven project with the aim of &lt;i&gt;replacing&lt;/i&gt; the X Window System with a secure and simpler windowing system for Linux.&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="251.65" x="1398.35" y="2690" as="geometry" />
        </mxCell>
        <mxCell id="ffJ0lFliinWhPomTt_Ha-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;shadow=1;" value="" vertex="1">

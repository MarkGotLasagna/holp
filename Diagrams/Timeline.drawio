          <mxGeometry height="109.998" width="169.75" x="-39.87" y="-38.87" as="geometry" />
        </mxCell>
        <mxCell id="cqSCvl8_K-0u57ZVZtha-25" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The birth of the&amp;nbsp;Unix&lt;br&gt;operating systems&lt;/h3&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Tasked by&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;AT&amp;amp;T Inc.&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;,&amp;nbsp;&lt;/span&gt;&lt;b&gt;Ken Thompson&lt;/b&gt; and &lt;b&gt;Dennis Ritchie&lt;/b&gt;&amp;nbsp;conceive&amp;nbsp;&lt;b&gt;Unix&lt;/b&gt;, a family of &lt;i&gt;multitasking&lt;/i&gt;, &lt;i&gt;multi-user&lt;/i&gt; computer &lt;i&gt;operating systems&lt;/i&gt;. Destined for the Bell System, Unix will be licensed to outside parties in the late 1970s, leading to a variety of both &lt;i&gt;academic and commercial variants&lt;/i&gt;.&lt;/p&gt;&lt;p&gt;Unix is meant to be a convenient platform for programmers developing software to be run on it and other operating systems. Its success comes from its interactivity, by providing the software at a nominal fee for educational use, by running on inexpensive hardware, and by easy to adapt and move to different machines.&lt;/p&gt;&lt;p&gt;Unix is written in &lt;b&gt;assembly&lt;/b&gt;, but will be soon rewritten in &lt;b&gt;C&lt;/b&gt;, a high-level programming language.&lt;/p&gt;" vertex="1">
          <mxGeometry height="400" width="202.49" x="-40" y="190" as="geometry" />
        </mxCell>
        <mxCell id="cqSCvl8_K-0u57ZVZtha-26" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" value="&lt;h3&gt;&lt;span&gt;1969&lt;/span&gt;&lt;/h3&gt;" vertex="1">

        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-539" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;Major companies now support Linux&lt;/h3&gt;&lt;div&gt;Companies like IBM and Oracle, announce their support for Linux. Netscape publicly releases the source code to its Netscape Communicator web browser suite.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Linux appears on the &lt;b&gt;TOP500 &lt;/b&gt;list of fastest supercomputers. &lt;a href=&quot;https://en.wikipedia.org/wiki/TOP500&quot;&gt;[17]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1156.67" y="527.69" width="173.33" height="202.31" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-749" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFDFDE,#392E29);shadow=1;" parent="1" vertex="1">
          <mxGeometry x="1150.34" y="1037.5" width="179.66" height="242.5" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-750" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The &lt;u&gt;Linux Foundation&lt;/u&gt;&lt;/h3&gt;&lt;div&gt;The &lt;b&gt;Linux Foundation&lt;/b&gt; starts as Open Source Development Labs to standardize and promote the open-source projects beyond the Linux OS. &lt;a href=&quot;https://en.wikipedia.org/wiki/Linux_Foundation&quot;&gt;[19]&lt;/a&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The foundation hosts annual educational events among the community, including the &lt;b&gt;Linux Kernel Developers Summit&lt;/b&gt; and &lt;b&gt;the Open Source Summit&lt;/b&gt;.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1156.05" y="1037.5" width="163.95" height="232.5" as="geometry" />
        </mxCell>

        <mxCell id="EbJxW3jv7QS7McjEMLKu-111" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The creation of &lt;u&gt;Linux&lt;/u&gt;&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Linus Torvalds&lt;/b&gt;, a computer science student at University of Helsinki, begins work on a personal project designed to work on his PC with an 80386 processor. Development is done on MINIX using the &lt;b&gt;GNU C Compiler&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This personal project will later become the &lt;b&gt;Linux kernel&lt;/b&gt;. &lt;a href=&quot;https://en.wikipedia.org/wiki/Linux_kernel&quot;&gt;[11]&lt;/a&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;He states that the project is &quot;&lt;i&gt;just a hobby&lt;/i&gt;&quot; and that it &quot;&lt;i&gt;won&#39;t be big and professional like gnu&lt;/i&gt;&quot;, on the online&amp;nbsp;&lt;i&gt;comp.os.minix&lt;/i&gt; newsgroup.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="907.13" y="188.63" width="212.87" height="241.37" as="geometry" />
        </mxCell>

          </mxGeometry>
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-181" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Linux v4.4&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;One of the most important &lt;b&gt;Long Term Support&lt;/b&gt; (LTS) versions of the Linux kernel, is released. It will be used for years by enterprise distributions and embedded systems.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Its &lt;b&gt;End-Of-Life&lt;/b&gt; (EOF) is set to be well over 10 years from release.&lt;/div&gt;" vertex="1">
          <mxGeometry height="159.37" width="202.87" x="1917.13" y="190.63" as="geometry" />
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-190" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFDCEC,#392E29);shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="220" width="220" x="1910" y="370" as="geometry" />
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-191" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;Snap&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Canonical&lt;/b&gt; releases &lt;b&gt;Snap&lt;/b&gt;, a software for &lt;i&gt;packaging&lt;/i&gt; and &lt;i&gt;deployment&lt;/i&gt;&amp;nbsp;for operating systems that use the Linux kernel and &lt;b&gt;systemd&lt;/b&gt; init system.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The packages, called &lt;i&gt;snaps&lt;/i&gt;, run in a container with limited access to the host system. They do so by heavily relying on the AppArmor security module of Linux&#39;s upstream &lt;br&gt;kernel.&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="201.83" x="1918.17" y="370" as="geometry" />
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-194" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFDCEC,#392E29);shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="200" width="220" x="1910" y="600" as="geometry" />
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-195" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;Flatpak&lt;/h3&gt;&lt;div&gt;The &lt;b&gt;Flatpak Team&lt;/b&gt; releases &lt;b&gt;Flatpak&lt;/b&gt;, an utility for &lt;i&gt;software deployment&lt;/i&gt; and &lt;i&gt;package management&lt;/i&gt; for Linux.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;It functions very similarly to Snap, but with a focus on &lt;i&gt;desktop applications&lt;/i&gt;, rather than server/IoT environments. Flatpak is more decentralized: developers can contribute their applications using the &lt;b&gt;Flathub&lt;/b&gt; repository.&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="201.83" x="1918.17" y="600" as="geometry" />
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-196" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;exitX=0;exitY=0.16;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.651;entryDx=0;entryDy=0;entryPerimeter=0;shadow=1;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="1910" y="921" as="sourcePoint" />
            <mxPoint x="1910" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-197" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;exitX=0;exitY=0.16;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.651;entryDx=0;entryDy=0;entryPerimeter=0;shadow=1;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="2130" y="861" as="sourcePoint" />
            <mxPoint x="2130" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-198" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFDCEC,#392E29);shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="250" width="220" x="1910" y="810" as="geometry" />
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-199" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;WSL&lt;/h3&gt;&lt;div&gt;At Microsoft Build 2016, &lt;b&gt;Microsoft&lt;/b&gt; announces &lt;b&gt;Windows Subsystem for Linux&lt;/b&gt; (WSL), a &lt;i&gt;translation layer&lt;/i&gt; that mapped Linux system calls to the Windows kernel. Now, native bash shells and Ubuntu user space tools could be run directly on &lt;b&gt;Windows 10&lt;/b&gt;.&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;This was also a move to stop developers from migrating to the macOS ecosystem.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Initially not open, most part of the code for WSL2 will later be &lt;br&gt;published under the &lt;b&gt;MIT&lt;/b&gt; license.&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="201.83" x="1918.17" y="810" as="geometry" />
        </mxCell>
        <mxCell id="nwM52ZXH9s9YM5WvnQR7-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#F4E4FF,#392E29);shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="90" width="220" x="1910" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="nwM52ZXH9s9YM5WvnQR7-4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;TOP500 is all Linux&lt;/h3&gt;&lt;div&gt;The Linux kernel now runs on all of the TOP500 fastest supercomputers in the world.&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="201.83" x="1918.17" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="nwM52ZXH9s9YM5WvnQR7-5" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fontColor=#000000;fontSize=10;" value="&lt;h3&gt;2017&lt;/h3&gt;" vertex="1">
          <mxGeometry height="8" width="28.83" x="2097" y="1084.37" as="geometry" />
        </mxCell>
        <mxCell id="nwM52ZXH9s9YM5WvnQR7-6" edge="1" parent="1" style="endArrow=none;html=1;rounded=1;flowAnimation=0;curved=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="2093" y="1097.37" />
            </Array>
            <mxPoint x="2130" y="1097.37" as="sourcePoint" />
            <mxPoint x="2093" y="1080.37" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nwM52ZXH9s9YM5WvnQR7-7" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;fontSize=10;" value="Zstd" vertex="1">
          <mxGeometry height="38" width="39.35" x="1839.69" y="-920" as="geometry" />
        </mxCell>
        <mxCell id="nwM52ZXH9s9YM5WvnQR7-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#FFE599;shadow=1;opacity=95;strokeWidth=2;gradientColor=none;gradientDirection=north;" value="" vertex="1">
          <mxGeometry height="149" width="220" x="1910" y="1181" as="geometry" />
        </mxCell>
        <mxCell id="nwM52ZXH9s9YM5WvnQR7-12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;" value="" vertex="1">
          <mxGeometry height="29.5" width="218.3" x="1910.6999999999998" y="1182" as="geometry" />
        </mxCell>
        <mxCell id="nwM52ZXH9s9YM5WvnQR7-13" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Linux v4.14&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Zstd&lt;/b&gt; compression support is added to the kernel. Developed by &lt;b&gt;Facebook&lt;/b&gt;, it offers a much better &lt;i&gt;compression ratio &lt;/i&gt;and &lt;i&gt;speed&lt;/i&gt; compared to &lt;b&gt;Zlib&lt;/b&gt;, improving performance for &lt;i&gt;compressed filesystems&lt;/i&gt; like &lt;b&gt;Btrfs&lt;/b&gt; and &lt;b&gt;Squashfs&lt;/b&gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="139" width="200.3" x="1919.7" y="1181" as="geometry" />
        </mxCell>
        <mxCell id="nwM52ZXH9s9YM5WvnQR7-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#FFDAEE;shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="270" width="220" x="1910" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="nwM52ZXH9s9YM5WvnQR7-19" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;Proton&lt;br&gt;&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Valve&lt;/b&gt; releases &lt;b&gt;Proton&lt;/b&gt;, a compatibility layer that allows Windows software (primarily &lt;i&gt;video games&lt;/i&gt;) to run on Linux-based operating systems. It is a collection of &lt;i&gt;software&lt;/i&gt; and &lt;i&gt;libraries&lt;/i&gt; combined with a patched version of &lt;b&gt;Wine&lt;/b&gt; to improve performance and compatibility with Windows games.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;ProtonDB, an unofficial community website, collect and displays crowdsourced data describing the compatibility of a given title with Proton.&lt;/div&gt;" vertex="1">

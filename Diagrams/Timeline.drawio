            <mxPoint x="1092" y="1240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-113" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;" value="" vertex="1">
          <mxGeometry height="30" width="230" x="900" y="1870" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-524" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Linux v2.0&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;Kernel version 2.0 is released. &lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;It can now serve several processors at the same time using &lt;b&gt;symmetric multiprocessing &lt;/b&gt;(SMP), becoming a serious alternative for many companies.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="212.44" x="907.56" y="1870" as="geometry" />
        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-53" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fontColor=#FFFFFF;fontSize=10;" value="&lt;h3&gt;&lt;span&gt;1996&lt;/span&gt;&lt;/h3&gt;" vertex="1">

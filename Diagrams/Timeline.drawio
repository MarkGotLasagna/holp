        <mxCell id="pUQc0dzP0XOw_koREINH-30" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The &lt;u&gt;GNU Project&lt;/u&gt;&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Richard Stallman&lt;/b&gt; starts the &lt;b&gt;GNU Project&lt;/b&gt; with the goal of creating a free UNIX-like operating system. The term GNU is a recursive acronym meaning &quot;&lt;i&gt;GNU&#39;s not Unix!&lt;/i&gt;&quot;. &lt;a href=&quot;https://en.wikipedia.org/wiki/GNU&quot;&gt;[4]&lt;/a&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;GNU&#39;s goal is to give computer users freedom and control in their use of their computers and computing devices by collaboratively developing and publishing software that gives everyone the rights to freely run the software, copy and distribute it, study it, and modify it.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;GNU software grants these rights in its license, the &lt;b&gt;GNU General Public License&lt;/b&gt; (&lt;b&gt;GPL&lt;/b&gt;). &lt;a href=&quot;https://en.wikipedia.org/wiki/GNU_General_Public_License&quot;&gt;[5]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="456.63" y="460" width="183.67" height="340" as="geometry" />
        </mxCell>

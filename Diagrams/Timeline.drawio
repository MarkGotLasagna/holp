        <mxCell id="ffJ0lFliinWhPomTt_Ha-53" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Raspberry Pi Foundation&lt;/h3&gt;&lt;div&gt;The &lt;b&gt;Raspberry Pi Foundation&lt;/b&gt;, a UK-based educational charity, is formed. It&#39;s goal is to promote the &lt;i&gt;study of computer science&lt;/i&gt; and related subjects globally, particularly among young people.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;It will be best known for initiating the &lt;b&gt;Raspberry Pi&lt;/b&gt; series of &lt;b&gt;single-board computers&lt;/b&gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="251.65" x="1398.35" y="2890" as="geometry" />
        </mxCell>

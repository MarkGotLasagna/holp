        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-94" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fontColor=#FFFFFF;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Git&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Linus Torvalds&lt;/b&gt; releases &lt;b&gt;Git&lt;/b&gt;, a &lt;i&gt;distributed version control software system&lt;/i&gt; that is capable of &lt;i&gt;managing versions&lt;/i&gt; of &lt;i&gt;source code&lt;/i&gt; or data, to the public.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;It is used to control source code by programmers who are &lt;i&gt;developing software collaboratively&lt;/i&gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="241.57" x="1398.43" y="1720" as="geometry" />
        </mxCell>

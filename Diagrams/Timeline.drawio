        <mxCell id="seZzuQpvaotzNjGEQc2U-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;shadow=1;" value="&lt;b&gt;init&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="71.55" x="-50" y="-290" as="geometry" />
        </mxCell>
        <mxCell id="seZzuQpvaotzNjGEQc2U-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;shadow=1;" value="&lt;b&gt;coreutils&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="1300" y="-100" as="geometry" />
        </mxCell>
        <mxCell id="seZzuQpvaotzNjGEQc2U-21" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="20.25" width="64.25" x="1527.8799999999999" y="-69.75" as="geometry" />
        </mxCell>
        <mxCell id="cqSCvl8_K-0u57ZVZtha-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;labelBackgroundColor=none;glass=0;textShadow=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; History Of Linux Project&lt;br&gt;&lt;/font&gt;&lt;/h1&gt;&lt;h3&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;The Linux kernel and the open-source initiative&lt;/font&gt;&lt;/h3&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;A timeline designed to illustrate how the Linux kernel came to be, from its origins till current day. Linux began as a personal project to create a new free operating system kernel. The resulting Linux kernel has been marked by constant growth throughout its history. Since the initial release of its source code in 1991, it has grown from a small number of files prohibiting commercial distribution to more than 23 million lines of source code, under the GNU GPL v2.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font&gt;&lt;a href=&quot;https://creativecommons.org/&quot;&gt;History of Linux Project&lt;/a&gt;&amp;nbsp;© 2025 by &lt;a href=&quot;https://creativecommons.org/&quot;&gt;Marco Rondelli&lt;/a&gt; &lt;br&gt;is licensed under &lt;a href=&quot;https://creativecommons.org/licenses/by-sa/4.0/&quot;&gt;CC BY-SA 4.0&lt;/a&gt;&lt;img style=&quot;max-width: 1em;max-height:1em;margin-left: .2em;&quot; alt=&quot;&quot; src=&quot;https://mirrors.creativecommons.org/presskit/icons/cc.svg&quot;&gt;&lt;img style=&quot;max-width: 1em;max-height:1em;margin-left: .2em;&quot; alt=&quot;&quot; src=&quot;https://mirrors.creativecommons.org/presskit/icons/by.svg&quot;&gt;&lt;img style=&quot;max-width: 1em;max-height:1em;margin-left: .2em;&quot; alt=&quot;&quot; src=&quot;https://mirrors.creativecommons.org/presskit/icons/sa.svg&quot;&gt;&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="208" width="480" x="-50" y="634" as="geometry" />
        </mxCell>

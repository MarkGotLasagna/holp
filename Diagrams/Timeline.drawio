        <mxCell id="EbJxW3jv7QS7McjEMLKu-609" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;X11&lt;/h3&gt;&lt;div&gt;A team of developers joins forces with the standard &lt;b&gt;X&lt;/b&gt; body to create the &lt;b&gt;X.Org Foundation&lt;/b&gt;, a non-profit corporation chartered to research, develop, support, organize, administrate, standardize, promote and defend a free and open accelerated graphics stack.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The &lt;b&gt;X.Org Server&lt;/b&gt;, an open-source implementation of the X Window System (&lt;b&gt;X11&lt;/b&gt;) display server, is released.&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="241.57" x="1398.43" y="910" as="geometry" />
        </mxCell>

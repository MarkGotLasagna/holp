        <mxCell id="EbJxW3jv7QS7McjEMLKu-787" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;Ubuntu&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Canonical Ltd&lt;/b&gt;. releases &lt;b&gt;Ubuntu&lt;/b&gt;, positioning it at a user-friendly Debian-based distribution. It will become the most popular desktop Linux distribution and one of the most influential projects in the &lt;br&gt;ecosystem.&lt;/div&gt;" vertex="1">
          <mxGeometry height="124" width="241.83" x="1398.17" y="1130" as="geometry" />
        </mxCell>

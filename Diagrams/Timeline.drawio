        <mxCell id="miqkyNGIwZH1A5y7qotn-14" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#DEEEFF;shadow=1;labelBorderColor=none;textShadow=0;glass=0;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="669.99" y="450" width="210" height="150" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-15" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Free Software Foundation&lt;/h3&gt;&lt;div&gt;Richard Stallman founds the &lt;b&gt;Free Software Foundation &lt;/b&gt;(&lt;b&gt;FSF&lt;/b&gt;). The organization supports the &lt;i&gt;free software movement&lt;/i&gt;, with its preference for software being distributed under &lt;i&gt;copyleft&lt;/i&gt; terms. &lt;a href=&quot;https://en.wikipedia.org/wiki/Free_Software_Foundation&quot;&gt;[8]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="678.8199999999999" y="448" width="194.33" height="142" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-20" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="1094.76" y="-56.85" width="135.88" height="45.93" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-22" value="&lt;h3&gt;&lt;span&gt;1995&lt;/span&gt;&lt;/h3&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="1050" y="120" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-24" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#ECFFDE;shadow=1;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="900" y="1050" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-25" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Red Hat Linux distribution&lt;/h3&gt;&lt;div&gt;The &lt;b&gt;Red Hat, Inc.&lt;/b&gt;&amp;nbsp;software company providing open-source software products to enterprises, subsidiary of IBM, releases &lt;b&gt;Red Hat Linux&lt;/b&gt;, a commercial open-source Linux distribution. &lt;a href=&quot;https://en.wikipedia.org/wiki/Red_Hat&quot;&gt;[14]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="909.7" y="1050" width="211" height="130" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-28" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="1532.4199999999998" y="-20.139999999999993" width="38.5" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-30" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFDCDD,#392E29);shadow=1;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="1350" y="190.38" width="180" height="239.62" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-31" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Arch Linux distribution&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Arch Linux&lt;/b&gt;, an open-source, &lt;i&gt;rolling release&lt;/i&gt; Linux distribution, is released. It is kept up-to-date by regularly updating the individual pieces of software it comprises. &lt;a href=&quot;https://en.wikipedia.org/wiki/Linux_Foundation&quot;&gt;[20]&lt;/a&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Arch Linux is intentionally &lt;i&gt;minimal&lt;/i&gt;, and is meant to be configured by the user during installation so they may add only what they require.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1358.17" y="188.63" width="171.65" height="231.37" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-32" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="1287.2099999999998" y="71.13" width="113.38" height="37.87" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-36" value="&lt;h3&gt;&lt;span&gt;2002&lt;/span&gt;&lt;/h3&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="1330" y="119.75" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-38" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFD7E0,#392E29);shadow=1;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="1350.08" y="649.75" width="180" height="250.25" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-39" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Fedora Linux distribution&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Fedora Linux&lt;/b&gt;, a distribution developed by the &lt;b&gt;Fedora Project&lt;/b&gt;, is released. It is a continuation of the &lt;b&gt;Red Hat Linux&lt;/b&gt; project. It contains software distributed under various free and open-source licenses and aims to be on the &lt;i&gt;leading edge of open-source technologies&lt;/i&gt;. &lt;a href=&quot;https://en.wikipedia.org/wiki/Fedora_Linux&quot;&gt;[22]&lt;/a&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Linus Torvalds uses Fedora as his daily Linux distribution.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1358.25" y="648" width="171.65" height="242" as="geometry" />
        </mxCell>

        <mxCell id="cqSCvl8_K-0u57ZVZtha-24" value="Ken Thompson (left) and&#xa;Dennis Ritchie (right)" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/jpeg,;shadow=0;clipPath=inset(0% 0% 0% 0% round 11%);fontSize=10;imageBorder=none;perimeterSpacing=5;" parent="1" vertex="1">

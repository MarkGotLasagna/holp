        </mxCell>
        <mxCell id="rQylpDqdkaOI6577g1rk-24" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The X window system&lt;/h3&gt;&lt;div&gt;From the joint Project Athena, the &lt;b&gt;X Window System&lt;/b&gt; is born. It is a &lt;i&gt;windowing system&lt;/i&gt; for &lt;i&gt;bitmap&lt;/i&gt; displays. X will become the most known windowing system on Unix-like operating systems. &lt;a href=&quot;https://en.wikipedia.org/wiki/X_Window_System&quot;&gt;[6]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="457.32" y="819.38" width="182.68" height="120" as="geometry" />

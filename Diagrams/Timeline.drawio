        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-45" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fontColor=#FFFFFF;fontSize=10;" value="&lt;h3&gt;&lt;span&gt;1991&lt;/span&gt;&lt;/h3&gt;" vertex="1">

          <mxGeometry x="669.77" y="1069.5" width="210" height="260" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-10" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The &lt;u&gt;POSIX&lt;/u&gt; standards&lt;/h3&gt;&lt;div&gt;The first standard of the&amp;nbsp;&lt;b&gt;Portable Operating System Interface&lt;/b&gt;&amp;nbsp;(&lt;b&gt;POSIX&lt;/b&gt;) is released. It is a family of standards specified by the &lt;i&gt;IEEE Computer Society&lt;/i&gt; for maintaining compatibility between operating systems.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;POSIX defines &lt;i&gt;application programming interfaces&lt;/i&gt; (APIs), along with command line &lt;i&gt;shells &lt;/i&gt;and utility interfaces, for software compatibility with various Unix and other operating systems. &lt;a href=&quot;https://en.wikipedia.org/wiki/POSIX&quot;&gt;[10]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="677.81" y="1069.5" width="193.68" height="260" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-11" value="" style="shape=waypoint;sketch=0;size=6;pointerEvents=1;points=[];fillColor=none;resizable=0;rotatable=0;perimeter=centerPerimeter;snapToPoint=1;strokeWidth=0.5;" parent="1" vertex="1">
          <mxGeometry x="859.86" y="1309.5" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-12" value="" style="endArrow=none;html=1;rounded=1;flowAnimation=0;curved=0;" parent="1" edge="1">

        <mxCell id="RG5WYI_STCJGxj8KXgSP-88" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14.04px;&quot;&gt;Red Hat Enterprise Linux&lt;/span&gt;&lt;/h3&gt;&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Red Hat Inc. &lt;span style=&quot;font-weight: normal;&quot;&gt;releases &lt;/span&gt;Red Hat Enterprise Linux&lt;span style=&quot;font-weight: normal;&quot;&gt; (RHEL), a commercial Linux distribution for x86_64, ARM64 and IBM Z server platforms.&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;&lt;div&gt;RHEL is advertised to enterprises as a more stable Linux distribution, having an extended support of life and maintenance period compared to other distributions.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The RHEL distribution will be one of the core distributions studied in &lt;br&gt;many system administration certificates.&lt;/div&gt;" vertex="1">

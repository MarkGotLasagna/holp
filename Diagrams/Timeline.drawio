        <mxCell id="EbJxW3jv7QS7McjEMLKu-466" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The first Linux &lt;u&gt;distributions&lt;/u&gt;&lt;br&gt;&lt;/h3&gt;&lt;div&gt;Over 100 developers work collectively on the Linux kernel. With their assistance, the kernel is adapted to the GNU environment.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;text-decoration-line: underline;&quot;&gt;Slackware&lt;/b&gt;&amp;nbsp;is released for the first time. &lt;a href=&quot;https://en.wikipedia.org/wiki/Slackware&quot;&gt;[12]&lt;/a&gt; In the same year, the&amp;nbsp;&lt;b&gt;&lt;u&gt;Debian&lt;/u&gt; &lt;/b&gt;project is established. It will later become the largest community distribution. &lt;a href=&quot;https://en.wikipedia.org/wiki/Debian&quot;&gt;[13]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="908.49" y="460" width="211.51" height="180" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-467" value="&lt;h3&gt;&lt;span&gt;1994&lt;/span&gt;&lt;/h3&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="1009.8700000000001" y="120.38" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-469" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#E2FFDE;shadow=1;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="899.3" y="879.5" width="230.7" height="150" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-470" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;Linux v1.0&lt;/h3&gt;&lt;div&gt;Linus judges all components of Linux to be fully matured, and releases kernel version 1.0.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Commercial Linux distribution makers &lt;b&gt;Red Hat&lt;/b&gt;&amp;nbsp;and &lt;b&gt;SUSE&lt;/b&gt;&amp;nbsp;also release their v1.0 Linux distributions.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" parent="1" vertex="1">

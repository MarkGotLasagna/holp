        </mxCell>
        <mxCell id="ffJ0lFliinWhPomTt_Ha-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#F7DFFF,#392E29);shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="178.25" width="220" x="1149.85" y="2841.75" as="geometry" />
        </mxCell>
        <mxCell id="ffJ0lFliinWhPomTt_Ha-19" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;Gentoo Linux&lt;br&gt;&lt;/h3&gt;&lt;div&gt;The &lt;b&gt;Gentoo Foundation&lt;/b&gt; releases the first version of &lt;b&gt;Gentoo Linux&lt;/b&gt;. It is a Linux distribution built using the &lt;b&gt;Portage&lt;/b&gt; &lt;i&gt;package management system&lt;/i&gt;. Unlike a binary software distribution, Gentoo &lt;i&gt;compiles the source locally&lt;/i&gt; according to the user&#39;s preferences and is often optimized for the specific type of computer.&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="199.85" x="1160" y="2841" as="geometry" />
        </mxCell>

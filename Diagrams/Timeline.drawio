        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-174" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;" value="" vertex="1">
          <mxGeometry height="29.5" width="218.3" x="1150.7" y="2342" as="geometry" />
        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-175" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Linux v2.4&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;Kernel version 2.4 is released.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Several filesystems including &lt;b&gt;ext3 &lt;/b&gt;are now supported. The introduced &lt;b&gt;netfilter &lt;/b&gt;framework allows various networking-related operations to be implemented in the form of customized handlers. This framework includes programs like &lt;b&gt;iptables&lt;/b&gt;, &lt;b&gt;arptables &lt;/b&gt;and &lt;b&gt;nftables&lt;/b&gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="200.3" x="1159.7" y="2341" as="geometry" />
        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-176" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;labelBackgroundColor=none;fontColor=#000000;fontSize=10;" value="&lt;h3&gt;&lt;span&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;2001&lt;/font&gt;&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="8" width="28.83" x="1337.7" y="2344.5" as="geometry" />
        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-177" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;flowAnimation=0;curved=0;strokeWidth=2;strokeColor=#FFFFFF;entryX=0.867;entryY=-0.008;entryDx=0;entryDy=0;entryPerimeter=0;" value="">

        <mxCell id="rQylpDqdkaOI6577g1rk-23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#FFFDDF;shadow=1;opacity=95;" value="" vertex="1">

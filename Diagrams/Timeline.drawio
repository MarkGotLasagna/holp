          <mxGeometry x="670.23" y="619.5" width="209.77" height="150" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-71" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Design of the UNIX Operating System&lt;/h3&gt;&lt;div&gt;Maurice J. Bach, of AT&amp;amp;T Bell Labs, publishes the definitive description of the UNIX operating systems, covering System V Release 2 kernel and some features from Release 3 and BSD.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="678.4000000000001" y="619.5" width="193.83" height="140" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-81" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#DEFEFF;shadow=1;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="670.23" y="788" width="210" height="261.5" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-96" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;u&gt;MINIX&lt;/u&gt;&lt;/h3&gt;&lt;div&gt;A Unix-like operating system based on a microkernel architecture, &lt;b&gt;MINIX&lt;/b&gt;, is released. It is written by American-Dutch computer scientist &lt;b&gt;Andrew S. Tanenbaum&lt;/b&gt;. Designed as a clone of the Unix operating system; MINIX is targeted for &lt;i&gt;use in classrooms by computer science students at universities&lt;/i&gt;. &lt;a href=&quot;https://en.wikipedia.org/wiki/Minix&quot;&gt;[9]&lt;/a&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Its name comes from &lt;i&gt;mini-Unix&lt;/i&gt;. It is proprietary source-available, but will be relicensed under the BSD 3-Clause to later become &lt;i&gt;free and open-source&lt;/i&gt;.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="678.5500000000001" y="788" width="193.68" height="251.5" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-58" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#DEE6FF;shadow=1;labelBorderColor=none;textShadow=0;glass=0;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="670" y="190" width="210" height="250" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-65" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The &lt;u&gt;Intel 386&lt;/u&gt; processor&lt;/h3&gt;&lt;div&gt;The&amp;nbsp;&lt;b&gt;80386&lt;/b&gt;&amp;nbsp;(&lt;b&gt;i386&lt;/b&gt;) is released, the first &lt;b&gt;x86&lt;/b&gt; microprocessor with a &lt;b&gt;32-bit instruction set&lt;/b&gt; in the line. It is jointly developed by AMD, IBM and Intel. &lt;a href=&quot;https://en.wikipedia.org/wiki/I386&quot;&gt;[7]&lt;/a&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;It is the first CPU to implement the &lt;b&gt;IA-32&lt;/b&gt; microarchitecture. It will be the brains of many workstations and high-end personal computers. Thanks to its &lt;i&gt;memory management unit&lt;/i&gt; (MMU) with &lt;i&gt;paging&lt;/i&gt;, it is much easier to implement operating systems using virtual memory.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="678.8299999999999" y="188" width="194.33" height="239.25" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-561" value="" style="shape=waypoint;sketch=0;size=6;pointerEvents=1;points=[];fillColor=none;resizable=0;rotatable=0;perimeter=centerPerimeter;snapToPoint=1;strokeWidth=0.5;" parent="1" vertex="1">
          <mxGeometry x="860.2299999999999" y="1029" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-562" value="" style="endArrow=none;html=1;rounded=1;flowAnimation=0;curved=0;" parent="1" edge="1">

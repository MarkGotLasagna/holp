        <mxCell id="lwQMdKJuDqDfSbL--Qch-23" value="&lt;h3&gt;&lt;span&gt;1984&lt;/span&gt;&lt;/h3&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="610" y="120" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-69" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#DEFFD8;shadow=1;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="900" y="661" width="230" height="198.99" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-70" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Common Desktop Environment&lt;/h3&gt;&lt;div&gt;The &lt;b&gt;Common Desktop Environment&lt;/b&gt; (&lt;b&gt;CDE&lt;/b&gt;) is a &lt;i&gt;desktop environment&lt;/i&gt; for Unix based on the Motif widget toolkit. It is part of the UNIX 98 Workstation Product Standard.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;It will help influence early implementations of successor projects such as &lt;b&gt;KDE &lt;/b&gt;and &lt;b&gt;GNOME&lt;/b&gt;.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="908.76" y="661" width="211.24" height="185" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-73" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#FEFFDE;shadow=1;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="898.76" y="1370" width="231.24" height="210" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-74" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The KDE free software community&lt;/h3&gt;&lt;div&gt;&lt;b&gt;KDE&lt;/b&gt;, a free software community, is born. It develops free and open-source software. Its products will include the famous &lt;b&gt;KDE Plasma&lt;/b&gt; graphical shell and &lt;b&gt;Krita&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Many KDE applications are &lt;i&gt;cross-platform&lt;/i&gt; and can run on Unix and Unix-like operating systems as well as Microsoft Windows. &lt;a href=&quot;https://en.wikipedia.org/wiki/KDE&quot;&gt;[15]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="907.5" y="1370" width="212.44" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-75" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFF9DE,#392E29);shadow=1;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="1150.18" y="190.38" width="179.82" height="179.62" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-76" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Xfce desktop environment&lt;/h3&gt;&lt;div&gt;Xfce, a free and open-source desktop environment for Linux and other Unix-like operating systems, is released.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;It aims to be fast and lightweight while still visually appealing and easy to use.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1158.35" y="188.63" width="171.65" height="171.37" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-77" value="&lt;h3&gt;&lt;span&gt;1997&lt;/span&gt;&lt;/h3&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" parent="1" vertex="1">
          <mxGeometry x="1130.0800000000002" y="120.13" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-79" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFF2DE,#392E29);shadow=1;glass=0;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="1150.5" y="390.87" width="179.5" height="129.13" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-80" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The GTK widget toolkit&lt;/h3&gt;&lt;div&gt;&lt;b&gt;GTK&lt;/b&gt;, a free and open-source widget toolkit for creating graphical user interfaces targeted at Linux and specifically GNOME, is released. &lt;a href=&quot;https://en.wikipedia.org/wiki/GTK&quot;&gt;[16]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1158.67" y="389.12" width="171.33" height="120.88" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-86" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFE5DE,#392E29);shadow=1;opacity=95;" parent="1" vertex="1">
          <mxGeometry x="1150.18" y="749.75" width="179.82" height="270.25" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-87" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The GNOME desktop environment&lt;/h3&gt;&lt;div&gt;&lt;b&gt;GNOME&lt;/b&gt; 1.0, a free and open-source desktop environment for Linux and other Unix-like operating systems, is born. It is considered one of the most famous alternatives to KDE.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Many major Linux distributions, including Debian, Fedora, Ubuntu, Red Hat, and SUSE will distribute GNOME as their default desktop environment. &lt;a href=&quot;https://en.wikipedia.org/wiki/GNOME&quot;&gt;[18]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1158.35" y="750" width="161.65" height="250" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-89" value="&lt;h4&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Trivia&lt;/font&gt;&lt;/span&gt;&lt;/h4&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;-&amp;nbsp;&lt;a href=&quot;https://en.wikipedia.org/wiki/Linux_distribution&quot; style=&quot;background-color: transparent;&quot;&gt;https://en.wikipedia.org/wiki/Linux_distribution&lt;/a&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;i style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;has a timeline of the development of main Linux distributions.&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-&amp;nbsp;&lt;a href=&quot;lwn.net&quot; style=&quot;font-style: normal;&quot;&gt;lwn.net&lt;/a&gt;&lt;span style=&quot;font-style: normal;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;i style=&quot;&quot;&gt;is an up to the minute news and information source for the free software community. Created in 1997, it has been publishing reader compatible news since then.&lt;/i&gt;&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;fontSize=8;" parent="1" vertex="1">
          <mxGeometry x="1517.09" y="1402.25" width="300" height="244.75" as="geometry" />
        </mxCell>

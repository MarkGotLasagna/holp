            <mxPoint x="879.86" y="1309.5" as="targetPoint" />
            <Array as="points">
              <mxPoint x="859.86" y="1309.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-557" value="" style="shape=waypoint;sketch=0;size=6;pointerEvents=1;points=[];fillColor=none;resizable=0;rotatable=0;perimeter=centerPerimeter;snapToPoint=1;strokeWidth=0.5;" parent="1" vertex="1">
          <mxGeometry x="860" y="420" width="20" height="20" as="geometry" />
        </mxCell>

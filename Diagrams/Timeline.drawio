        </mxCell>
        <mxCell id="rQylpDqdkaOI6577g1rk-24" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The X window system&lt;/h3&gt;&lt;div&gt;From the joint Project Athena, the &lt;b&gt;X Window System&lt;/b&gt; is born. It is a &lt;i&gt;windowing system&lt;/i&gt; for &lt;i&gt;bitmap&lt;/i&gt; displays. X will become the most known windowing system on Unix-like operating systems.&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="460" y="829.38" as="geometry" />
        </mxCell>
        <mxCell id="rQylpDqdkaOI6577g1rk-31" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;editableCssRules=.*;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry height="67.38" width="48.8" x="1041.0600000000002" y="-323.68999999999994" as="geometry" />
        </mxCell>
        <mxCell id="rQylpDqdkaOI6577g1rk-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;shadow=1;" value="" vertex="1">
          <mxGeometry height="42.37" width="50" x="810" y="-382.37" as="geometry" />
        </mxCell>
        <mxCell id="rQylpDqdkaOI6577g1rk-37" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/jpeg,;" value="" vertex="1">
          <mxGeometry height="30.5" width="41.93" x="814.03" y="-376.43999999999994" as="geometry" />
        </mxCell>
        <mxCell id="rQylpDqdkaOI6577g1rk-39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;shadow=1;" value="&lt;b&gt;PGP&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="40.04" x="979.96" y="-280" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-23" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" value="&lt;h3&gt;&lt;span&gt;1984&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="610" y="120" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-69" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#DCFFE1;shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="209" width="230" x="900" y="851" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-70" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Common Desktop Environment&lt;/h3&gt;&lt;div&gt;The &lt;b&gt;Common Desktop Environment&lt;/b&gt; (&lt;b&gt;CDE&lt;/b&gt;) is a &lt;i&gt;desktop environment&lt;/i&gt;&amp;nbsp;(DE) for Unix based on the Motif widget toolkit. It is part of the UNIX 98 Workstation Product Standard.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;It will help influence early implementations of successor &lt;br&gt;projects such as &lt;b&gt;KDE &lt;/b&gt;and &lt;br&gt;&lt;b&gt;GNOME&lt;/b&gt;.&lt;/div&gt;" vertex="1">
          <mxGeometry height="199" width="211.24" x="908.76" y="851" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#DCFFFC;shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="210" width="230" x="900" y="2030" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-74" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The KDE free software community&lt;/h3&gt;&lt;div&gt;&lt;b&gt;KDE&lt;/b&gt;, a free software community, is born. It develops free and open-source software. Its products will include the famous &lt;b&gt;KDE Plasma&lt;/b&gt; graphical shell and &lt;b&gt;Krita&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Many KDE applications are &lt;i&gt;cross-platform&lt;/i&gt; and can run on Unix and Unix-like operating systems &lt;br&gt;as well as Microsoft Windows.&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="209.94" x="910" y="2030" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-75" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#E4F5FF,#392E29);shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="179.62" width="219.82" x="1150.18" y="190.38" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-76" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Xfce &lt;br&gt;desktop environment&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Xfce&lt;/b&gt;, a free and open-source desktop environment for Linux and other Unix-like operating systems, is released.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;It aims to be &lt;i&gt;fast&lt;/i&gt; and &lt;i&gt;lightweight&lt;/i&gt; while still visually appealing and &lt;br&gt;easy to use.&lt;/div&gt;" vertex="1">
          <mxGeometry height="173" width="201.65" x="1158.35" y="190" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-77" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" value="&lt;h3&gt;&lt;span&gt;1997&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="1130.0800000000002" y="120.13" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-79" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#E1EFFF,#392E29);shadow=1;glass=0;opacity=95;" value="" vertex="1">
          <mxGeometry height="269.13" width="220" x="1150" y="420.87" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-80" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;GUI creation &lt;br&gt;using the GTK toolkit&lt;/h3&gt;&lt;div&gt;&lt;b&gt;GTK&lt;/b&gt;, a free and open-source widget toolkit for creating &lt;i&gt;graphical user interfaces&lt;/i&gt; (GUI) targeted at Linux and specifically GNOME, is released.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Today, many application make use of the GTK toolkit, including: GIMP, Inkscape, LibreOffice, Mozilla Firefox, REAPER, and Transmission.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Desktop environments make use of the GTK toolkit: GNOME, Cinnamon, MATE, and Xfce, all use GTK as &lt;br&gt;their widget toolkit.&lt;/div&gt;" vertex="1">
          <mxGeometry height="264" width="201.33" x="1158.67" y="420" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-86" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#EAE6FF,#392E29);shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="220.25" width="220" x="1150" y="1349.75" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-87" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The GNOME &lt;br&gt;desktop environment&lt;br&gt;&lt;/h3&gt;&lt;div&gt;&lt;b&gt;GNOME&lt;/b&gt; &lt;b&gt;1.0&lt;/b&gt;, a free and open-source &lt;i&gt;desktop environment&lt;/i&gt; for Linux and other Unix-like operating systems, is born. It is considered one of the most famous alternatives to KDE.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Many major Linux distributions, including Debian, Fedora, Ubuntu, Red Hat, and SUSE will distribute GNOME as their default desktop environment.&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="201.65" x="1158.35" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="lwQMdKJuDqDfSbL--Qch-89" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=8;" value="&lt;h4&gt;&lt;/h4&gt;&lt;h3&gt;&lt;span style=&quot;font-size: 12px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Trivia and miscellaneous information&lt;/span&gt;&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;a href=&quot;https://en.wikipedia.org/wiki/Linux_distribution&quot; style=&quot;background-color: transparent; font-weight: normal;&quot;&gt;https://en.wikipedia.org/wiki/Linux_distribution&lt;/a&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;&amp;nbsp;references&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;a timeline of the development of main Linux distributions.&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;The terms &lt;i&gt;kernel space&lt;/i&gt;&amp;nbsp;and &lt;i&gt;user space&lt;/i&gt;&amp;nbsp;are used to represent separate operating system&#39;s address spaces. The kernel space is strictly reserved for running a privileged kernel, extensions and device drivers. The user space is dedicated to application software, deamons and some drivers execute. This separation primarily provides security, as in memory and hardware protection.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Torvalds announced the mascot of the Linux kernel in 1996. The inspiration came from his visit to the National Zoo &amp;amp; Aquarium in Canberra, Australia, after being bitten by a little penguin. The original draft was provided by Larry Ewing.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;a href=&quot;lwn.net&quot;&gt;lwn.net&lt;/a&gt;&amp;nbsp;is an up to the minute news and information source for the free software community. Created in 1997, it has been publishing reader compatible news since then.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&quot;I use Arch BTW&quot; is a popular meme and catchphrase used to make fun of the type of person who feels superior because they use a more &lt;i&gt;difficult&lt;/i&gt;&amp;nbsp;Linux distribution.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&quot;So NVDIA, fuck you&quot;. In a talk held at Aalto University in Helsinki, Finland, Torvalds criticizes the NVIDIA corporation, saying it has been the quote, &quot;[...] single worst company we have ever dealt with&quot;.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Coined by the Canadian writer Cory Doctorow, the term &quot;enshittification&quot; is used to describe the deliberate decline of quality in products over time. Adopting a widespread use in many communities, it describes the type of products that &quot;get you hooked but get worse to improve short-term profits for shareholders&quot;.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="360" width="470" x="-50" y="1790" as="geometry" />
        </mxCell>
        <mxCell id="D-_JiE1x4j5c7dNLg_JD-4" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="27.94" width="124.18" x="1612.9099999999999" y="-68.94" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-7" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" value="&lt;h3&gt;&lt;span&gt;1988&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="770" y="120" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#F2FFE9;shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="250.5" width="210" x="669.77" y="1089.5" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-10" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The POSIX standards&lt;/h3&gt;&lt;div&gt;The first standard of the&amp;nbsp;&lt;b&gt;Portable Operating System Interface&lt;/b&gt;&amp;nbsp;(&lt;b&gt;POSIX&lt;/b&gt;) is released. It is a family of standards specified by the &lt;b&gt;IEEE Computer Society&lt;/b&gt; for maintaining compatibility between operating systems.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;POSIX defines &lt;i&gt;application programming interfaces&lt;/i&gt; (APIs), along with command line &lt;i&gt;shells &lt;/i&gt;and utility interfaces, for software compatibility with various Unix and other operating systems.&lt;/div&gt;" vertex="1">
          <mxGeometry height="240.5" width="193.68" x="677.81" y="1089.5" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=#F9FFE1;shadow=1;labelBorderColor=none;textShadow=0;glass=0;opacity=95;" value="" vertex="1">
          <mxGeometry height="150" width="210" x="669.99" y="470" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-15" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;fontFamily=Helvetica;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Free Software Foundation&lt;/h3&gt;&lt;div&gt;Richard Stallman founds the &lt;b&gt;Free Software Foundation &lt;/b&gt;(&lt;b&gt;FSF&lt;/b&gt;). The organization supports the &lt;i&gt;free software movement&lt;/i&gt;, with its preference for software being distributed under &lt;i&gt;copyleft&lt;/i&gt; terms.&lt;/div&gt;" vertex="1">
          <mxGeometry height="142" width="194.33" x="678.8199999999999" y="468" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-20" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="45.93" width="135.88" x="1082.06" y="-56.85" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-22" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" value="&lt;h3&gt;&lt;span&gt;1995&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="1050" y="120" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=default;shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="150" width="230" x="900" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-25" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The Red Hat &lt;br&gt;Linux distribution&lt;/h3&gt;&lt;div&gt;The &lt;b&gt;Red Hat, Inc.&lt;/b&gt;&amp;nbsp;software company providing open-source software products to enterprises, subsidiary of IBM, releases &lt;b&gt;Red Hat Linux&lt;/b&gt;, a commercial open-source Linux distribution.&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="211" x="909.7" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-28" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="38.5" width="38.5" x="1532.7899999999997" y="-23.979999999999993" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=default;shadow=1;gradientColor=light-dark(#B2E8FF,#EDEDED);gradientDirection=south;opacity=95;" value="" vertex="1">
          <mxGeometry height="279.62" width="220" x="1150" y="2550.38" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-31" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;Arch Linux&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Arch Linux&lt;/b&gt;, an open-source, &lt;i&gt;rolling release&lt;/i&gt; Linux distribution, is released. It is kept up-to-date by regularly updating the individual pieces of software it comprises.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Arch Linux is intentionally &lt;i&gt;minimal&lt;/i&gt;, and is meant to be configured by the user during installation so they may add only what they require.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The &lt;b&gt;Arch Linux Wiki&lt;/b&gt;, one of the largest and well documented wikis in the Linux community, is used among users from many different distributions.&lt;/div&gt;" vertex="1">
          <mxGeometry height="270.37" width="200" x="1160" y="2549.63" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-36" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" value="&lt;h3&gt;&lt;span&gt;2002&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="1330" y="119.75" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FCDFFF,#392E29);shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="190.25" width="259.92" x="1390.08" y="699.75" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-39" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;Fedora&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Fedora Linux&lt;/b&gt;, a distribution developed by the &lt;b&gt;Fedora Project&lt;/b&gt;, is released. It is a continuation of the &lt;b&gt;Red Hat Linux&lt;/b&gt; project. It contains software distributed under various free and open-source licenses and aims to be on the &lt;i&gt;leading edge of open-source technologies&lt;/i&gt;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Linus Torvalds uses Fedora as his daily Linux distribution.&lt;/div&gt;" vertex="1">
          <mxGeometry height="184" width="241.75" x="1398.25" y="700" as="geometry" />
        </mxCell>
        <mxCell id="miqkyNGIwZH1A5y7qotn-49" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" value="&lt;h3&gt;&lt;span&gt;2003&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="1370.32" y="120.38" as="geometry" />
        </mxCell>

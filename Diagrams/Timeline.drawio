          </mxGeometry>
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-123" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFDAF3,#392E29);shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="220" width="220" x="1670" y="2950" as="geometry" />
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-124" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14.04px;&quot;&gt;Vulkan&lt;/span&gt;&lt;/h3&gt;&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Khronos Group&lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt; announces &lt;/span&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;Vulkan&lt;/span&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;, a cross-platform API and open standard for 3D graphics and computing. It is designed to support a wide variety of GPUs, CPUs and operating systems, and modern multicore CPUs.&lt;/span&gt;&lt;/h3&gt;&lt;div&gt;Thanks to Vulkan, the performance gap in games running on Linux could be closed further.&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="201.83" x="1678.17" y="2950" as="geometry" />
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-129" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="52.5" width="126.2" x="946.9" y="-460.88" as="geometry" />
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-137" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=default;shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="269" width="230" x="900" y="1571" as="geometry" />
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-138" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;Mesa: the open source collection of graphics API&lt;/h3&gt;&lt;div&gt;The open-source implementation of graphics API specifications &lt;b&gt;Mesa&lt;/b&gt;, is released. It will implement the &lt;b&gt;OpenGL&lt;/b&gt;, &lt;b&gt;Vulkan&lt;/b&gt; and &lt;b&gt;OpenCL&lt;/b&gt; specifications.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Mesa translates the specifications to vendor-specific graphics hardware drivers, like for &lt;b&gt;Intel&lt;/b&gt; and &lt;b&gt;AMD&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Mesa will work in tandem with Linux&#39;s &lt;b&gt;Direct Rendering Manager&lt;/b&gt; (DRM) driver responsible for interfacing &lt;br&gt;with GPUs of modern video cards.&lt;/div&gt;" vertex="1">
          <mxGeometry height="259" width="211.24" x="908.76" y="1571" as="geometry" />
        </mxCell>
        <mxCell id="RG5WYI_STCJGxj8KXgSP-143" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;fontSize=10;" value="Project 64" vertex="1">

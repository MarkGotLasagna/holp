        <mxCell id="EbJxW3jv7QS7McjEMLKu-442" value="&lt;h3&gt;&lt;span&gt;1993&lt;/span&gt;&lt;/h3&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;labelBackgroundColor=none;fontColor=#000000;" parent="1" vertex="1">

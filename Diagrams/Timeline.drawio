          <mxGeometry x="1350" y="1220" width="180" height="180" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-787" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The most famous Linux distribution: Ubuntu&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Canonical Ltd&lt;/b&gt;. releases &lt;b&gt;Ubuntu&lt;/b&gt;, positioning it at a user-friendly Debian-based distribution. It will become the most popular desktop Linux distribution and one of the most influential projects in the ecosystem. &lt;a href=&quot;https://en.wikipedia.org/wiki/Ubuntu&quot;&gt;[24]&lt;/a&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" parent="1" vertex="1">
          <mxGeometry x="1358.17" y="1218" width="160.33" height="170" as="geometry" />
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-788" value="" style="endArrow=oval;html=1;rounded=0;startArrow=oval;startFill=1;endFill=1;shadow=1;flowAnimation=0;entryX=0.216;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" target="EbJxW3jv7QS7McjEMLKu-71" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="720.12" y="150" as="sourcePoint" />
            <mxPoint x="720" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EbJxW3jv7QS7McjEMLKu-789" value="" style="endArrow=oval;html=1;rounded=0;startArrow=oval;startFill=1;endFill=1;shadow=1;flowAnimation=0;entryX=0.422;entryY=0.001;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" target="EbJxW3jv7QS7McjEMLKu-96" edge="1">

        <mxCell id="EbJxW3jv7QS7McjEMLKu-111" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Linux&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;&lt;b&gt;Linus Torvalds&lt;/b&gt;, a computer science student at University of Helsinki, begins work on a personal project designed to work on his PC with an 80386 processor. Development is done on MINIX using the &lt;b&gt;GNU C Compiler&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;This personal project will later become the &lt;b&gt;Linux kernel&lt;/b&gt;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;He states that the project is &quot;&lt;i&gt;just a hobby&lt;/i&gt;&quot; and that it &quot;&lt;i&gt;won&#39;t be big and professional like gnu&lt;/i&gt;&quot;, on the online&amp;nbsp;&lt;i&gt;comp.os.minix&lt;/i&gt; newsgroup.&lt;/div&gt;" vertex="1">
          <mxGeometry height="241.37" width="212.87" x="907.13" y="188.63" as="geometry" />
        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-118" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="33" width="262" x="1389" y="409" as="geometry" />
        </mxCell>
        <mxCell id="HhSyCPqw7SMtaCZ9Isdi-87" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Linux v2.6&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;Kernel version 2.6 is released.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Its new &lt;b&gt;O(1) scheduler&lt;/b&gt; significantly improves performance and fairness on multiprocessor systems. The &lt;b&gt;ALSA&lt;/b&gt; software framework replaces the Open Sound System (OSS) as the default API for &lt;i&gt;sound card device drivers&lt;/i&gt;. Early in the same year, high-speed &lt;b&gt;USB 2.0&lt;/b&gt; support will be fully implemented.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The &lt;b&gt;Security-Enhanced Linux&lt;/b&gt; (&lt;b&gt;SELinux&lt;/b&gt;) module is merged into upstream. It provides mechanisms for supporting &lt;i&gt;access control security policies&lt;/i&gt;, including &lt;i&gt;mandatory access controls&lt;/i&gt; (MAC).&lt;/div&gt;" vertex="1">
          <mxGeometry height="269" width="241.57" x="1398.43" y="411" as="geometry" />
        </mxCell>

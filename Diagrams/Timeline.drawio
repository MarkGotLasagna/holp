        <mxCell id="ffJ0lFliinWhPomTt_Ha-45" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;The PulseAudio&amp;nbsp;sound server&lt;/h3&gt;&lt;div&gt;&lt;b&gt;PulseAudio&lt;/b&gt;, a &lt;b&gt;network-capable sound server&lt;/b&gt; program is released. It will be the default sound server on many Linux distributions.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="241.83" x="1398.17" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="ffJ0lFliinWhPomTt_Ha-52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=light-dark(#FFDFDF,#392E29);shadow=1;opacity=95;" value="" vertex="1">

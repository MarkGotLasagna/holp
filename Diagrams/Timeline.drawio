        <mxCell id="mfl3sMW6L31x2Bezmogu-10" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14.04px;&quot;&gt;The Wine compatibility layer&lt;/span&gt;&lt;/h3&gt;&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;The first version of &lt;/span&gt;Wine&lt;span style=&quot;font-weight: normal;&quot;&gt;, a compatibility layer, is released. It allows &lt;i&gt;application software&lt;/i&gt; and &lt;i&gt;computer games&lt;/i&gt; developed for Microsoft Windows to &lt;i&gt;run on Unix-like operating systems&lt;/i&gt;.&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="140.24" width="211.24" x="908.76" y="1069.76" as="geometry" />
        </mxCell>
        <mxCell id="mfl3sMW6L31x2Bezmogu-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;labelBackgroundColor=none;fillColor=default;shadow=1;opacity=95;" value="" vertex="1">
          <mxGeometry height="199" width="220" x="1150" y="901" as="geometry" />
        </mxCell>
        <mxCell id="mfl3sMW6L31x2Bezmogu-16" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;textShadow=0;align=left;verticalAlign=top;labelBackgroundColor=none;fillColor=none;" value="&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 14.04px;&quot;&gt;AppArmor&lt;/span&gt;&lt;/h3&gt;&lt;h3 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;AppArmor&lt;span style=&quot;font-weight: normal;&quot;&gt;, a Linux kernel security module, is released. It allows system administrators to restrict program&#39;s capabilities with per-program profiles.&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;AppArmor supplements the traditional &lt;/span&gt;&lt;b&gt;Unix Discretionary Access Control &lt;/b&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;(DAC) model by providing &lt;/span&gt;&lt;b&gt;Mandatory Access Control&lt;/b&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt; (MAC).&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="189" width="201.24" x="1158.76" y="901" as="geometry" />
        </mxCell>

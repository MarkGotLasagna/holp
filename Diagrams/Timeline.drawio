        <mxCell id="rQylpDqdkaOI6577g1rk-4" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/jpeg,;fontSize=10;clipPath=inset(0% 0% 0% 0% round 5%);" value="A VAX-11/780" vertex="1">
          <mxGeometry height="116.31" width="86.4571" x="106.78000000000002" y="-351.31" as="geometry" />
